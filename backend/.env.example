# Copy this file to .env (same folder) and fill the values from Bitwarden: "bareeq - backend .env"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=bareeq
DB_USER=bareeq
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Where login codes go. Leave empty for now: codes are printed in the server window.
OTP_SENDER=accounts.otp_senders.ConsoleOtpSender

# Online payments: "fake" = test payment page, no real money (change before launch)
PAYMENT_GATEWAY=fake

# Browser pages allowed to call the API (testing the app on Chrome)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
